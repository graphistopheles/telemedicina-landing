---
/** Plantilla de detalle de recurso (2º nivel del hub editorial). */
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import Icon from '../../components/ui/Icon.astro';
import { clp } from '../../scripts/format';

export async function getStaticPaths() {
  const recursos = await getCollection('recursos');
  return recursos.map((r) => ({ params: { id: r.id }, props: { recurso: r } }));
}

const { recurso } = Astro.props;
const { Content } = await render(recurso);
const pack = recurso.data.packRelacionado ? await getEntry(recurso.data.packRelacionado) : undefined;
const b2b = recurso.data.audiencia === 'empresas';
---

<Base titulo={`${recurso.data.titulo} · Medismart`} descripcion={recurso.data.bajada}>
  <Header />
  <main id="contenido" class="art" data-audiencia={recurso.data.audiencia} data-etapa={recurso.data.etapa}>
    <div class="wrap art__in">
      <a class="art__back mono" href="/#recursos">← Recursos</a>
      <p class="mono art__meta">{b2b ? 'Para líderes' : 'Para cuidarte'} · {recurso.data.formato}</p>
      <h1 class="display">{recurso.data.titulo}</h1>
      <p class="lead">{recurso.data.bajada}</p>
      <div class="art__body"><Content /></div>

      {pack && (
        <aside class="art__cta">
          <p class="mono">Siguiente paso</p>
          <h2 class="display">{pack.data.nombre}</h2>
          <p>{pack.data.promesa} · {clp(pack.data.precio)}</p>
          <a class="btn btn--primary" href="/#packs" data-cta={`recurso-pack-${pack.id}`}>Ver pack <span class="btn__ic"><Icon name="arrow" /></span></a>
        </aside>
      )}
      {b2b && (
        <aside class="art__cta art__cta--b2b">
          <p class="mono">Siguiente paso</p>
          <h2 class="display">Calcula el retorno para tu empresa</h2>
          <a class="btn btn--light" href="/#roi" data-cta="recurso-roi">Ir a la calculadora <span class="btn__ic"><Icon name="arrow" /></span></a>
        </aside>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .art { padding-block: clamp(48px, 8vw, 104px); }
  .art__in { max-width: 820px; display: grid; gap: 22px; }
  .art__back { font-weight: 700; font-size: 0.9rem; text-decoration: none; color: var(--text-2); }
  .art__meta { font-weight: 700; font-size: 0.86rem; color: var(--accent-ink); text-transform: none; letter-spacing: 0; }
  .art h1 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); }
  .art__body { padding-block: 28px; border-top: 1px solid var(--line); font-size: 1.08rem; color: var(--text-2); }
  .art__cta { padding: clamp(28px, 4vw, 44px); border-radius: 28px; background: var(--accent-soft); display: grid; gap: 14px; justify-items: start; }
  .art__cta h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .art__cta .mono { font-family: var(--f-body); text-transform: none; letter-spacing: 0; font-size: 0.9rem; font-weight: 700; color: var(--accent-ink); }
  .art__cta--b2b { background: var(--deep); color: var(--on-deep); }
  .art__cta--b2b .mono { color: var(--teal); }
</style>
