---
/**
 * Encabezado de sección: titular + bajada apilados.
 * - Énfasis tonal automático (estilo IntegratedBio): si el título tiene dos
 *   frases ("Tres pasos. Ninguna sala de espera."), la segunda se muestra en
 *   gris. Si solo tiene una, se muestra completa en color principal.
 * - `etiqueta` (opcional) muestra la categoría encima del título. Úsala con
 *   moderación: como máximo en una de cada tres secciones.
 * Los textos se editan en src/data/home.ts, no aquí.
 */
interface Props {
  id: string;
  titulo: string;
  bajada?: string;
  etiqueta?: string;
  dark?: boolean;
  centrado?: boolean;
}
const { id, titulo, bajada, etiqueta, dark = false, centrado = false } = Astro.props;

// Divide en la primera frase (". ", ", " o "? ") solo si queda algo sustancial después.
const m = titulo.match(/^(.+?[.,?])\s+(.{6,})$/);
const [principal, tono] = m ? [m[1], m[2]] : [titulo, ''];
---

<header class:list={['sh', { 'sh--dark': dark, 'sh--center': centrado }]}>
  {etiqueta && <p class="tag reveal">{etiqueta}</p>}
  <h2 id={`${id}-titulo`} class="h2 reveal">
    {principal}{tono && <> <span class="tone">{tono}</span></>}
  </h2>
  {bajada && <p class="lead reveal" style="--d:80ms">{bajada}</p>}
</header>

<style>
  .sh { display: grid; gap: 22px; justify-items: start; margin-bottom: clamp(48px, 6vw, 80px); max-width: 880px; }
  .sh .h2 { max-width: 20ch; }
  .sh--center { justify-items: center; text-align: center; margin-inline: auto; }
  .sh--center .lead { margin-inline: auto; }
  .sh--dark .h2 .tone { color: var(--on-deep-3); }
  .sh--dark .lead { color: var(--on-deep-2); }
  .sh--dark .tag { background: var(--deep-2); border-color: var(--line-deep); color: var(--on-deep-2); }
  .sh--dark .tag::before { background: var(--teal); }
</style>
