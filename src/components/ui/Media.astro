---
/**
 * <Media slot="clave" />
 * ---------------------------------------------------------------------------
 * Muestra la imagen del slot definido en src/data/imagenes.ts.
 * - estado 'placeholder' → marco con nombre del slot, tamaño, ruta destino y
 *   URL de la foto de referencia (como texto: el placeholder puede ir dentro de
 *   tarjetas que ya son enlaces, y un <a> dentro de otro rompe el HTML).
 * - estado 'final'       → <img> con el archivo de /public.
 * - MOSTRAR_REFERENCIAS  → muestra la foto de referencia para revisar la
 *   composición (no usar en producción).
 * NO edites imágenes aquí: edita el manifiesto.
 */
import { imagenes, MOSTRAR_REFERENCIAS, type ClaveImagen } from '../../data/imagenes';

interface Props {
  slot: ClaveImagen;
  class?: string;
  /** Carga prioritaria (solo para la imagen del hero). */
  prioridad?: boolean;
  /** Relación de aspecto CSS, ej. "4 / 5". */
  ratio?: string;
}
const { slot, class: className, prioridad = false, ratio } = Astro.props;
const img = imagenes[slot];
const src = img.estado === 'final' ? img.archivo : MOSTRAR_REFERENCIAS ? img.referencia : null;
---

<figure class:list={['media', className]} style={ratio ? `aspect-ratio:${ratio}` : undefined} data-slot={slot}>
  {src ? (
    <img src={src} alt={img.alt} loading={prioridad ? 'eager' : 'lazy'} fetchpriority={prioridad ? 'high' : 'auto'} decoding="async" />
  ) : (
    <>
      {/* Comentario HTML visible en el código fuente publicado, para quien edite el sitio. */}
      <Fragment set:html={`<!-- PLACEHOLDER [${slot}] Reemplazar por: public${img.archivo} (${img.tamano}px). Referencia: ${img.referencia}. Ubicación: ${img.ubicacion}. Editar en src/data/imagenes.ts -->`} />
      <div class="media__ph" role="img" aria-label={img.alt}>
        <span class="media__slot">{slot}</span>
        <span class="media__meta">
          <strong>{img.tamano}</strong>
          <code>{img.archivo}</code>
          <span class="media__ref" title={img.referencia}>Ref.: {img.referencia.replace(/^https:\/\//, '').split('?')[0]}</span>
        </span>
      </div>
    </>
  )}
</figure>

<style>
  .media { position: relative; margin: 0; overflow: hidden; border-radius: var(--r-card); background: var(--bg-2); }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .media__ph {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-start; gap: 12px; padding: 18px;
    background:
      radial-gradient(120% 90% at 85% 10%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 60%),
      radial-gradient(90% 80% at 0% 100%, color-mix(in oklab, var(--blue) 10%, transparent), transparent 60%),
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in oklab, var(--text) 3%, transparent) 14px 15px),
      var(--bg-2);
    color: var(--text-2);
  }
  .media__slot { align-self: flex-start; font-family: var(--f-mono); font-size: 0.68rem; letter-spacing: 0.06em; padding: 5px 10px; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line); }
  .media__meta { display: grid; gap: 2px; font-size: 0.78rem; max-width: 34ch; padding: 10px 12px; border-radius: 12px; background: color-mix(in oklab, var(--surface) 80%, transparent); }
  .media__meta strong { font-family: var(--f-display); font-weight: 500; font-size: 1rem; color: var(--text); }
  .media__meta code { font-family: var(--f-mono); font-size: 0.7rem; word-break: break-all; }
  .media__ref { color: var(--accent-ink); font-weight: 600; font-size: 0.72rem; word-break: break-all; }
</style>
