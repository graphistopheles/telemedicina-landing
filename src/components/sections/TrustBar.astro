---
/**
 * SELLOS · Franja de confianza bajo el hero
 * Fila 1: pruebas del hero (copy.inicio.pruebas en src/data/home.ts).
 * Fila 2: marquesina con los sellos (colección src/content/certificaciones.json).
 *         Es la ÚNICA marquesina de la página.
 */
import { getCollection } from 'astro:content';
import type { SeccionMeta, HomeCopy } from '../../data/home';
import { copy as home } from '../../data/home';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';

interface Props { meta: SeccionMeta; copy: HomeCopy['sellos'] }
const { meta, copy } = Astro.props;
const sellos = await getCollection('certificaciones');
const pruebas = home.inicio.pruebas;
---

<Section meta={meta} class="trust">
  <div class="wrap">
    <h2 id={`${meta.id}-titulo`} class="sr-only">{copy.titulo}</h2>
    <ul class="proofs">
      {pruebas.map((p, i) => (
        <li class="reveal" style={`--d:${i * 80}ms`}><Icon name={['users', 'seal', 'shield'][i] ?? 'check'} size={22} /><span>{p}</span></li>
      ))}
    </ul>
  </div>

  <div class="marquee" aria-label={copy.titulo}>
    <div class="marquee__track">
      {[0, 1].map((rep) => (
        <ul aria-hidden={rep === 1 ? 'true' : undefined}>
          {sellos.map(({ data }) => (
            <li><span class="seal">{data.sigla}</span>{data.nombre}<span class="by">{data.emisor}</span></li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</Section>

<style>
  :global(section.section.trust) { padding-block: 0 clamp(56px, 7vw, 96px); }
  .proofs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-block: 1px solid var(--line); }
  @media (min-width: 820px) { .proofs { grid-template-columns: repeat(3, 1fr); } }
  .proofs li { display: flex; align-items: center; gap: 14px; padding: 24px 0; font-family: var(--f-display); font-weight: 500; letter-spacing: -0.02em; font-size: 1.05rem; }
  .proofs li + li { border-top: 1px solid var(--line); }
  @media (min-width: 820px) { .proofs li + li { border-top: 0; border-left: 1px solid var(--line); padding-left: 28px; } }
  .proofs :global(svg) { flex: none; color: var(--accent-ink); }

  .marquee { margin-top: 40px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee__track { display: flex; width: max-content; }
  .marquee ul { list-style: none; margin: 0; padding: 0 28px 0 0; display: flex; gap: 28px; }
  .marquee li { display: inline-flex; align-items: center; gap: 12px; white-space: nowrap; font-family: var(--f-display); font-weight: 500; font-size: 1rem; letter-spacing: -0.02em; }
  .seal { font-family: var(--f-mono); font-size: 0.7rem; letter-spacing: 0.04em; padding: 6px 10px; border-radius: var(--r-pill); border: 1px solid var(--line-2); color: var(--accent-ink); }
  .by { color: var(--text-3); font-size: 0.9rem; }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__track { animation: slide 48s linear infinite; }
    .marquee:hover .marquee__track { animation-play-state: paused; }
  }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { flex-wrap: wrap; width: auto; } .marquee ul[aria-hidden] { display: none; } .marquee ul { flex-wrap: wrap; padding: 0 var(--gutter); } }
</style>
