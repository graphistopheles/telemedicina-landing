---
/**
 * PREGUNTAS FRECUENTES · Columna centrada con acordeones, agrupados por audiencia.
 * Preguntas → src/content/faqs.json (también alimentan el JSON-LD FAQPage para Google).
 */
import { getCollection } from 'astro:content';
import type { SeccionMeta, HomeCopy } from '../../data/home';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

interface Props { meta: SeccionMeta; copy: HomeCopy['preguntas'] }
const { meta, copy } = Astro.props;
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.orden - b.data.orden);
const grupos = [
  { aud: 'pacientes', titulo: 'Personas', items: faqs.filter((f) => f.data.audiencia !== 'empresas') },
  { aud: 'empresas', titulo: 'Empresas', items: faqs.filter((f) => f.data.audiencia !== 'pacientes') },
];
---

<Section meta={meta} tono="bg-2">
  <div class="wrap faq">
    <SectionHeader id={meta.id} titulo={copy.titulo} centrado />
    {grupos.map((g) => (
      <div class="group reveal">
        <h3>{g.titulo}</h3>
        <div class="qas">
          {g.items.map(({ data }, i) => (
            <details class="qa" open={i === 0 && g.aud === 'pacientes'}>
              <summary>{data.pregunta}<span class="qa__ic"><Icon name="plus" size={18} /></span></summary>
              <p>{data.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  .faq { max-width: 880px; }
  .group + .group { margin-top: 48px; }
  .group h3 { font-size: 1rem; font-weight: 600; color: var(--text-2); margin-bottom: 14px; padding-left: 4px; }
  .qas { display: grid; gap: 8px; }
  .qa { border-radius: var(--r-card); background: var(--surface); border: 1px solid var(--line); transition: box-shadow 0.4s var(--ease); }
  .qa[open] { box-shadow: var(--shadow); }
  .qa summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 20px 20px 26px; cursor: pointer; font-family: var(--f-display); font-weight: 500; font-size: 1.08rem; letter-spacing: -0.02em; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa__ic { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-2); transition: transform 0.45s var(--ease), background-color 0.3s, color 0.3s; }
  .qa[open] .qa__ic { transform: rotate(45deg); background: var(--accent); color: var(--on-accent); }
  .qa p { padding: 0 72px 24px 26px; color: var(--text-2); }
</style>
