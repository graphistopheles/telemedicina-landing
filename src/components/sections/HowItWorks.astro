---
/**
 * CÓMO FUNCIONA · Título fijo a la izquierda + pasos en filas a la derecha.
 * Textos → src/data/home.ts (copy['como-funciona'].pasos)
 */
import type { SeccionMeta, HomeCopy } from '../../data/home';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

interface Props { meta: SeccionMeta; copy: HomeCopy['como-funciona'] }
const { meta, copy } = Astro.props;
const iconos = ['sparkle', 'video', 'pill']; // un ícono por paso, en orden
---

<Section meta={meta} tono="bg-2">
  <div class="wrap hiw">
    <div class="hiw__head">
      <SectionHeader id={meta.id} titulo={copy.titulo} />
    </div>
    <ol class="steps">
      {copy.pasos.map((p, i) => (
        <li class="step reveal" style={`--d:${i * 90}ms`}>
          <span class="step__n">{p.n}</span>
          <div class="step__body">
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
          <span class="step__ic"><Icon name={iconos[i]} size={24} /></span>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .hiw { display: grid; gap: 8px; }
  @media (min-width: 980px) {
    .hiw { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; }
    .hiw__head { position: sticky; top: 120px; }
  }
  .steps { list-style: none; margin: 0; padding: 0; }
  .step { display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: start; padding: 36px 0; border-top: 1px solid var(--line-2); }
  .step:last-child { border-bottom: 1px solid var(--line-2); }
  .step__n { font-family: var(--f-display); font-weight: 300; font-size: clamp(2.6rem, 4vw, 3.6rem); line-height: 0.9; letter-spacing: -0.05em; color: var(--text-3); min-width: 2.2ch; }
  .step h3 { font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.15; margin-bottom: 10px; }
  .step p { color: var(--text-2); max-width: 46ch; }
  .step__ic { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--line); color: var(--accent-ink); transition: background-color 0.3s, color 0.3s, transform 0.5s var(--ease); }
  .step:hover .step__ic { background: var(--accent); color: var(--on-accent); transform: rotate(-8deg); }
  @media (max-width: 560px) { .step { grid-template-columns: auto 1fr; } .step__ic { display: none; } }
</style>
