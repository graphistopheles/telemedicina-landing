---
/**
 * HERO · Split asimétrico
 * Izquierda: etiqueta, titular (2ª parte en gris), bajada y 2 CTA.
 * Derecha: foto del paciente (slot "hero") con la conversación AIda encima.
 * Debajo: puerta de entrada a la ruta Empresas.
 *
 * Textos → src/data/home.ts (copy.inicio)   ·   Foto → src/data/imagenes.ts (hero)
 * Las "pruebas" (+7M usuarios, etc.) se muestran en la franja de sellos, justo debajo.
 */
import type { SeccionMeta, HomeCopy } from '../../data/home';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import Media from '../ui/Media.astro';

interface Props { meta: SeccionMeta; copy: HomeCopy['inicio'] }
const { meta, copy } = Astro.props;
const { paciente, aida } = copy.conversacion;
---

<Section meta={meta} class="hero">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="tag hero__in" style="--i:0">{copy.eyebrow}</p>
      <h1 id={`${meta.id}-titulo`} class="display hero__title hero__in" style="--i:1">
        {copy.titulo} <span class="tone">{copy.tituloAcento}</span>
      </h1>
      <p class="lead hero__in" style="--i:2">{copy.bajada}</p>
      <div class="hero__ctas hero__in" style="--i:3">
        <a class="btn btn--primary" href={copy.ctaPrimario.href} data-cta="hero-consultar">
          {copy.ctaPrimario.label}<span class="btn__ic"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn--ghost" href={copy.ctaSecundario.href} data-cta="hero-packs">{copy.ctaSecundario.label}</a>
      </div>
    </div>

    <div class="hero__visual hero__in" style="--i:2">
      <Media slot="hero" prioridad ratio="4 / 5" class="hero__photo" />

      <!-- Conversación AIda (componente real, textos en copy.inicio.conversacion) -->
      <div class="chat" aria-hidden="true">
        <div class="bubble bubble--in">
          <header><span class="av">{paciente.nombre.slice(0, 1)}</span><strong>{paciente.nombre}</strong><time>{paciente.hora}</time></header>
          <p>{paciente.texto}</p>
        </div>
        <div class="bubble bubble--out">
          <header><span class="av av--ai"><Icon name="sparkle" size={14} /></span><strong>AIda</strong><time>{aida.hora}</time></header>
          <div class="bubble__card">
            <strong>{aida.titulo}</strong>
            <dl>{aida.filas.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          </div>
        </div>
        <div class="doc">
          <span class="doc__av">{copy.tarjeta.medico.split(' ').slice(-2).map((w) => w[0]).join('')}</span>
          <span class="doc__txt"><strong>{copy.tarjeta.medico}</strong><small>{copy.tarjeta.especialidad}</small></span>
          <span class="doc__live">{copy.tarjeta.estado}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <a class="gate hero__in" style="--i:4" href={copy.puertaB2B.href} data-cta="hero-puerta-b2b">
      <span class="gate__q">{copy.puertaB2B.label}</span>
      <span class="gate__cta">{copy.puertaB2B.cta}<Icon name="arrow-up-right" size={18} /></span>
    </a>
  </div>
</Section>

<style>
  :global(section.section.hero) { padding-top: clamp(32px, 5vw, 72px); padding-bottom: clamp(56px, 7vw, 96px); overflow: clip; }
  .hero__glow { position: absolute; width: 900px; height: 900px; right: -260px; top: -320px; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, var(--accent) 16%, transparent), transparent 62%); pointer-events: none; }

  .hero__grid { position: relative; display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 1.2fr 1fr; gap: 64px; min-height: min(720px, calc(100dvh - 180px)); } }

  .hero__copy { display: grid; gap: 28px; justify-items: start; }
  .hero__title { font-size: clamp(2.4rem, 4vw, 3.6rem); max-width: 19ch; text-wrap: balance; }
  .hero__title .tone { color: var(--text-3); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }

  /* Entrada escalonada */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in { animation: rise 1.1s var(--ease) both; animation-delay: calc(var(--i) * 90ms + 80ms); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }

  /* Visual */
  .hero__visual { position: relative; }
  .hero__visual :global(.hero__photo) { border-radius: 28px; box-shadow: var(--shadow-lg); }
  .chat { position: absolute; left: -48px; right: 24px; bottom: 28px; display: grid; gap: 10px; justify-items: start; }
  @media (max-width: 999px) { .chat { left: 16px; right: 16px; bottom: 16px; } }

  .bubble { width: min(340px, 100%); padding: 12px 14px; border-radius: 16px; background: color-mix(in oklab, var(--surface) 88%, transparent); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); border: 1px solid var(--line); box-shadow: var(--shadow); font-size: 0.88rem; }
  .bubble header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .bubble header strong { font-family: var(--f-display); font-weight: 500; font-size: 0.86rem; }
  .bubble time { margin-left: auto; font-family: var(--f-mono); font-size: 0.66rem; color: var(--text-2); }
  .bubble p { color: var(--text-2); line-height: 1.45; }
  .bubble--out { margin-left: 56px; width: min(340px, calc(100% - 56px)); }
  .av { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-2); font-size: 0.72rem; font-weight: 700; }
  .av--ai { background: var(--accent); color: var(--on-accent); }
  .bubble__card { padding: 10px 12px; border-radius: 12px; background: var(--bg-2); }
  .bubble__card > strong { display: block; font-family: var(--f-display); font-weight: 500; margin-bottom: 6px; }
  .bubble__card dl { margin: 0; display: grid; gap: 3px; }
  .bubble__card dl div { display: flex; justify-content: space-between; gap: 12px; font-size: 0.8rem; }
  .bubble__card dt { color: var(--text-2); }
  .bubble__card dd { margin: 0; font-weight: 700; }

  .doc { display: inline-flex; align-items: center; gap: 10px; margin-left: 56px; max-width: calc(100% - 56px); padding: 8px 14px 8px 8px; border-radius: var(--r-pill); background: var(--text); color: var(--bg); box-shadow: var(--shadow); }
  .doc__av { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); font-size: 0.72rem; font-weight: 700; }
  .doc__txt { display: grid; line-height: 1.2; }
  .doc__txt strong { font-size: 0.84rem; }
  .doc__txt small { font-size: 0.72rem; opacity: 0.7; }
  .doc__live { margin-left: 6px; font-size: 0.72rem; font-weight: 700; color: var(--teal); }

  @media (prefers-reduced-motion: no-preference) {
    .bubble--in { animation: rise 0.9s var(--ease) 0.7s both; }
    .bubble--out { animation: rise 0.9s var(--ease) 1.1s both; }
    .doc { animation: rise 0.9s var(--ease) 1.5s both; }
  }

  /* Puerta B2B */
  .gate { margin-top: clamp(48px, 6vw, 72px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; padding: 22px 0; border-top: 1px solid var(--line-2); text-decoration: none; }
  .gate__q { font-family: var(--f-display); font-weight: 500; letter-spacing: -0.03em; font-size: clamp(1.15rem, 2vw, 1.5rem); }
  .gate__cta { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--accent-ink); }
  .gate :global(svg) { transition: transform 0.35s var(--ease); }
  .gate:hover :global(svg) { transform: translate(3px, -3px); }
</style>
